{
  "manifestVersion": 3,
  "env": {
    "PATH": "$(npx -c \"node --print process.env.PATH\")"
  },
  "tasks": {
    "build": {
      "name": "build",
      "description": "Full release build",
      "steps": [
        {
          "spawn": "default"
        },
        {
          "spawn": "pre-compile"
        },
        {
          "spawn": "compile"
        },
        {
          "spawn": "post-compile"
        },
        {
          "spawn": "test"
        },
        {
          "spawn": "package"
        }
      ]
    },
    "bump": {
      "name": "bump",
      "description": "Bumps version based on latest git tag and generates a changelog entry",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^12"
      },
      "steps": [
        {
          "builtin": "release/resolve-latest-tag",
          "outputEnv": "LATEST_TAG"
        },
        {
          "spawn": "bump:releasable-commits",
          "outputEnv": "RELEASABLE_COMMITS",
          "condition": "git rev-parse --verify --quiet \"refs/tags/$LATEST_TAG\""
        },
        {
          "builtin": "release/suggest-version-bump",
          "outputEnv": "SUGGESTED_BUMP"
        },
        {
          "builtin": "release/apply-version-bump"
        }
      ],
      "condition": "git log --oneline -1 | grep -v \"chore(release):\" > /dev/null"
    },
    "bump:releasable-commits": {
      "name": "bump:releasable-commits",
      "description": "Print the releasable commits since the latest release",
      "steps": [
        {
          "exec": "git log --oneline $LATEST_TAG..HEAD"
        }
      ]
    },
    "bundle": {
      "name": "bundle",
      "description": "Prepare assets",
      "steps": [
        {
          "spawn": "bundle:lambda/tailscale-proxy"
        },
        {
          "spawn": "bundle:lambda/proxy-warmer"
        }
      ]
    },
    "bundle:lambda/proxy-warmer": {
      "name": "bundle:lambda/proxy-warmer",
      "description": "Create a JavaScript bundle from ./src/lambda/proxy-warmer/",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "./src/lambda/proxy-warmer/",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/lambda/proxy-warmer/index.js",
            "--sourcemap"
          ]
        }
      ]
    },
    "bundle:lambda/proxy-warmer:watch": {
      "name": "bundle:lambda/proxy-warmer:watch",
      "description": "Continuously update the JavaScript bundle from ./src/lambda/proxy-warmer/",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "./src/lambda/proxy-warmer/",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/lambda/proxy-warmer/index.js",
            "--sourcemap",
            "--watch"
          ]
        }
      ]
    },
    "bundle:lambda/tailscale-proxy": {
      "name": "bundle:lambda/tailscale-proxy",
      "description": "Create a JavaScript bundle from ./src/lambda/tailscale-proxy/",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "./src/lambda/tailscale-proxy/",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/lambda/tailscale-proxy/index.js",
            "--sourcemap"
          ]
        }
      ]
    },
    "bundle:lambda/tailscale-proxy:watch": {
      "name": "bundle:lambda/tailscale-proxy:watch",
      "description": "Continuously update the JavaScript bundle from ./src/lambda/tailscale-proxy/",
      "steps": [
        {
          "execArgs": [
            "esbuild",
            "--bundle",
            "./src/lambda/tailscale-proxy/",
            "--target=node24",
            "--platform=node",
            "--outfile=assets/lambda/tailscale-proxy/index.js",
            "--sourcemap",
            "--watch"
          ]
        }
      ]
    },
    "clobber": {
      "name": "clobber",
      "description": "hard resets to HEAD of origin and cleans the local repo",
      "env": {
        "BRANCH": "$(git branch --show-current)"
      },
      "steps": [
        {
          "execArgs": [
            "git",
            "checkout",
            "-b",
            "scratch"
          ],
          "name": "save current HEAD in \"scratch\" branch"
        },
        {
          "exec": "git checkout \"$BRANCH\""
        },
        {
          "execArgs": [
            "git",
            "fetch",
            "origin"
          ],
          "name": "fetch latest changes from origin"
        },
        {
          "exec": "git reset --hard \"origin/$BRANCH\"",
          "name": "hard reset to origin commit"
        },
        {
          "execArgs": [
            "git",
            "clean",
            "-fdx"
          ],
          "name": "clean all untracked files"
        },
        {
          "say": "ready to rock! (unpushed commits are under the \"scratch\" branch)"
        }
      ],
      "condition": "git diff --exit-code > /dev/null"
    },
    "compat": {
      "name": "compat",
      "description": "Perform API compatibility check against latest version",
      "steps": [
        {
          "execArgs": [
            "jsii-diff",
            "npm:tailscale-lambda-proxy",
            "-k",
            "--ignore-file",
            ".compatignore"
          ]
        }
      ]
    },
    "compile": {
      "name": "compile",
      "description": "Only compile",
      "steps": [
        {
          "exec": "jsii --silence-warnings=reserved-word"
        }
      ]
    },
    "default": {
      "name": "default",
      "description": "Synthesize project files",
      "steps": [
        {
          "execArgs": [
            "ts-node",
            "--project",
            "projenrc/tsconfig.json",
            ".projenrc.ts"
          ]
        }
      ]
    },
    "docgen": {
      "name": "docgen",
      "description": "Generate API.md from .jsii manifest",
      "steps": [
        {
          "execArgs": [
            "jsii-docgen",
            "-o",
            "API.md"
          ]
        }
      ]
    },
    "eject": {
      "name": "eject",
      "description": "Remove projen from the project",
      "env": {
        "PROJEN_EJECTING": "true"
      },
      "steps": [
        {
          "spawn": "default"
        }
      ]
    },
    "eslint": {
      "name": "eslint",
      "description": "Runs eslint against the codebase",
      "env": {
        "ESLINT_USE_FLAT_CONFIG": "false",
        "NODE_NO_WARNINGS": "1"
      },
      "steps": [
        {
          "execArgs": [
            "eslint",
            "--ext",
            ".ts,.tsx",
            "--fix",
            "--no-error-on-unmatched-pattern",
            "$@",
            "src",
            "test",
            "build-tools",
            "projenrc",
            ".projenrc.ts"
          ],
          "receiveArgs": true
        }
      ]
    },
    "install": {
      "name": "install",
      "description": "Install project dependencies and update lockfile (non-frozen)",
      "steps": [
        {
          "exec": "npm install"
        }
      ]
    },
    "install:ci": {
      "name": "install:ci",
      "description": "Install project dependencies using frozen lockfile",
      "steps": [
        {
          "exec": "npm ci"
        }
      ]
    },
    "package": {
      "name": "package",
      "description": "Creates the distribution package",
      "steps": [
        {
          "spawn": "package:js",
          "condition": "node -e \"if (!process.env.CI) process.exit(1)\""
        },
        {
          "spawn": "package-all",
          "condition": "node -e \"if (process.env.CI) process.exit(1)\""
        }
      ]
    },
    "package-all": {
      "name": "package-all",
      "description": "Packages artifacts for all target languages",
      "steps": [
        {
          "spawn": "package:js"
        },
        {
          "spawn": "package:python"
        }
      ]
    },
    "package:js": {
      "name": "package:js",
      "description": "Create js language bindings",
      "steps": [
        {
          "execArgs": [
            "jsii-pacmak",
            "-v",
            "--target",
            "js"
          ]
        }
      ]
    },
    "package:python": {
      "name": "package:python",
      "description": "Create python language bindings",
      "steps": [
        {
          "execArgs": [
            "jsii-pacmak",
            "-v",
            "--target",
            "python"
          ]
        }
      ]
    },
    "post-compile": {
      "name": "post-compile",
      "description": "Runs after successful compilation",
      "steps": [
        {
          "spawn": "docgen"
        },
        {
          "exec": "cp assets/lambda/tailscale-proxy/index.js lib/lambda/tailscale-proxy/index.js"
        },
        {
          "exec": "cp assets/lambda/tailscale-proxy/index.js lib/lambda/tailscale-proxy/index.js.map"
        },
        {
          "exec": "cp assets/lambda/proxy-warmer/index.js lib/lambda/proxy-warmer/index.js"
        },
        {
          "exec": "cp assets/lambda/proxy-warmer/index.js lib/lambda/proxy-warmer/index.js.map"
        }
      ]
    },
    "post-upgrade": {
      "name": "post-upgrade",
      "description": "Runs after upgrading dependencies"
    },
    "pre-compile": {
      "name": "pre-compile",
      "description": "Prepare the project for compilation",
      "steps": [
        {
          "spawn": "bundle"
        }
      ]
    },
    "release": {
      "name": "release",
      "description": "Prepare a release from \"main\" branch",
      "env": {
        "RELEASE": "true"
      },
      "steps": [
        {
          "execArgs": [
            "rm",
            "-fr",
            "dist"
          ]
        },
        {
          "spawn": "bump"
        },
        {
          "spawn": "build"
        },
        {
          "spawn": "unbump"
        },
        {
          "exec": "git diff --ignore-space-at-eol --exit-code"
        }
      ]
    },
    "test": {
      "name": "test",
      "description": "Run tests",
      "steps": [
        {
          "execArgs": [
            "jest",
            "--passWithNoTests",
            "--updateSnapshot"
          ],
          "receiveArgs": true
        },
        {
          "spawn": "eslint"
        }
      ]
    },
    "test:watch": {
      "name": "test:watch",
      "description": "Run jest in watch mode",
      "steps": [
        {
          "execArgs": [
            "jest",
            "--watch"
          ]
        }
      ]
    },
    "unbump": {
      "name": "unbump",
      "description": "Restores version to 0.0.0",
      "env": {
        "OUTFILE": "package.json",
        "CHANGELOG": "dist/changelog.md",
        "BUMPFILE": "dist/version.txt",
        "RELEASETAG": "dist/releasetag.txt",
        "RELEASE_TAG_PREFIX": "",
        "BUMP_PACKAGE": "commit-and-tag-version@^12"
      },
      "steps": [
        {
          "builtin": "release/reset-version"
        }
      ]
    },
    "upgrade": {
      "name": "upgrade",
      "description": "upgrade dependencies",
      "env": {
        "CI": "0"
      },
      "steps": [
        {
          "execArgs": [
            "npx",
            "npm-check-updates@20",
            "--upgrade",
            "--target=minor",
            "--peer",
            "--no-deprecated",
            "--dep=dev,prod,peer,optional",
            "--filter=@types/jest,@types/node,esbuild,eslint-import-resolver-typescript,eslint-plugin-import,husky,jest,jsii-diff,jsii-pacmak,projen,ts-jest,ts-node,typescript,@aws-lambda-powertools/metrics,@aws-sdk/client-lambda,@types/aws-lambda,socks-proxy-agent,tailscale-lambda-extension"
          ]
        },
        {
          "exec": "npm install"
        },
        {
          "execArgs": [
            "npm",
            "update",
            "@stylistic/eslint-plugin",
            "@types/jest",
            "@types/node",
            "@typescript-eslint/eslint-plugin",
            "@typescript-eslint/parser",
            "commit-and-tag-version",
            "esbuild",
            "eslint-import-resolver-typescript",
            "eslint-plugin-import",
            "eslint",
            "husky",
            "jest",
            "jest-junit",
            "jsii-diff",
            "jsii-docgen",
            "jsii-pacmak",
            "jsii-rosetta",
            "jsii",
            "projen",
            "ts-jest",
            "ts-node",
            "typescript",
            "@aws-lambda-powertools/metrics",
            "@aws-sdk/client-lambda",
            "@types/aws-lambda",
            "socks-proxy-agent",
            "aws-cdk-lib",
            "constructs",
            "tailscale-lambda-extension"
          ]
        },
        {
          "exec": "npx projen"
        },
        {
          "spawn": "post-upgrade"
        }
      ]
    },
    "watch": {
      "name": "watch",
      "description": "Watch & compile in the background",
      "steps": [
        {
          "exec": "jsii -w --silence-warnings=reserved-word"
        }
      ]
    }
  },
  "//": "~~ Generated by projen. To modify, edit .projenrc.ts and run \"npx projen\"."
}
